# BIDFLUX backend configuration
# Copy to .env and adjust. Defaults work for local development.
# There are no secrets in this application — no auth, no external API keys.

APP_ENV=development
API_VERSION=1.0.0

# SQLite file, created automatically on first run.
DATABASE_URL=sqlite:///./bidflux.db

# Where uploaded tender/bidder files are written (sanitised filenames).
STORAGE_DIR=./storage

# Comma-separated exact origins allowed by CORS. Never use "*" in production.
CORS_ORIGINS=http://localhost:3000

# Hard upload size limit in megabytes. The body is read into memory first and
# validated before anything is written (not streamed to disk).
MAX_UPLOAD_MB=10

# mock    -> simulated AI services, flagged as MOCK in API responses and UI.
#            This is the only mode this build ships with.
# disabled -> reserved; disables simulated extraction, but this build has no
#            manual requirement-entry UI, so the workflow stalls. Stay on mock.
AI_MODE=mock
